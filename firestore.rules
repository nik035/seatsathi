rules_version = '2';
// SeatSathi — Firestore security rules.
// Paste into Firebase console → Firestore Database → Rules → Publish.
// Replace YOUR_ADMIN_EMAIL with the Google email you'll use as admin (same as ADMIN_EMAILS in js/config.js).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isAdmin() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email in ['YOUR_ADMIN_EMAIL@gmail.com'];
    }
    function libOwner(libId) { return get(/databases/$(database)/documents/libraries/$(libId)).data.ownerId; }
    function changes(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // ── People ──
    match /users/{uid} {
      allow read: if signedIn() && (me() == uid || isAdmin());
      allow create: if signedIn() && me() == uid && request.resource.data.role in ['student', 'owner'];
      allow update: if signedIn() && me() == uid && request.resource.data.role == resource.data.role;
      allow delete: if isAdmin();
    }

    // ── Libraries (public listing) ──
    match /libraries/{libId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerId == me()
        && get(/databases/$(database)/documents/users/$(me())).data.role == 'owner';
      allow update: if (signedIn() && resource.data.ownerId == me() && request.resource.data.ownerId == me()
                        && (request.resource.data.status != 'suspended' || resource.data.status == 'suspended')
                        && (resource.data.status != 'suspended' || request.resource.data.status == 'suspended'))
                    || isAdmin();
      allow delete: if signedIn() && (resource.data.ownerId == me() || isAdmin());

      // Seat occupancy: public, no personal data. Students may only place / remove their own hold.
      match /seats/{seatNo} {
        allow read: if true;
        allow create: if signedIn() && (libOwner(libId) == me()
          || (request.resource.data.state == 'held' && request.resource.data.uid == me()
              && request.resource.data.libraryId == libId));
        allow update: if signedIn() && (libOwner(libId) == me() || isAdmin());
        allow delete: if signedIn() && (libOwner(libId) == me() || isAdmin()
          || (resource.data.state == 'held' && resource.data.uid == me()));
      }

      // Waitlist: a student adds themselves; the owner can see and clear it.
      match /waitlist/{uid} {
        allow read: if signedIn() && (me() == uid || libOwner(libId) == me() || isAdmin());
        allow create, update: if signedIn() && me() == uid;
        allow delete: if signedIn() && (me() == uid || libOwner(libId) == me());
      }
    }
    match /{path=**}/seats/{seatNo} {
      allow read: if true;
    }

    // ── Memberships (who sits where) ──
    match /memberships/{id} {
      allow read: if signedIn() && (resource.data.studentId == me() || resource.data.ownerId == me() || isAdmin());
      allow create: if signedIn() && request.resource.data.ownerId == libOwner(request.resource.data.libraryId)
        && (request.resource.data.ownerId == me()
            || (request.resource.data.studentId == me() && request.resource.data.status == 'pending'));
      allow update: if signedIn() && (resource.data.ownerId == me() || isAdmin()
        || (resource.data.studentId == me() && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled' && changes(['status'])));
      allow delete: if signedIn() && (resource.data.ownerId == me() || isAdmin());
    }

    // ── Payments (students claim, owners confirm) ──
    match /payments/{id} {
      allow read: if signedIn() && (resource.data.studentId == me() || resource.data.ownerId == me() || isAdmin());
      allow create: if signedIn() && request.resource.data.ownerId == libOwner(request.resource.data.libraryId)
        && (request.resource.data.ownerId == me()
            || (request.resource.data.studentId == me() && request.resource.data.status == 'claimed'));
      allow update: if signedIn() && (resource.data.ownerId == me() || isAdmin());
      allow delete: if isAdmin();
    }

    // ── Reviews ──
    match /reviews/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.studentId == me()
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.text is string && request.resource.data.text.size() <= 500;
      allow delete: if signedIn() && (resource.data.studentId == me() || isAdmin());
    }

    // ── Anonymous daily visit counter (admin chart) ──
    match /visits/{id} {
      allow create: if request.resource.data.keys().hasOnly(['day', 'role', 'at'])
        && request.resource.data.day is string && request.resource.data.day.size() == 10;
      allow read: if isAdmin();
    }
  }
}
